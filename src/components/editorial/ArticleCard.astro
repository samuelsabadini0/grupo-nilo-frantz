---
import type { Article } from '../../data/articles';
import type { Brand } from '../../data/brands';
import { cardLabel, postHref } from '../../data/blog';
interface Props { article: Article; brand: Brand; delay?: number }
const { article, brand, delay = 0 } = Astro.props;
---
<article class="ed-card reveal" data-ed-card style={`--d:${delay}s`}>
  <a href={postHref(article)}>
    <div class="media"><img src={article.image} alt="" loading="lazy" /></div>
    <div class="ed-card__meta"><b>{cardLabel(brand, article)}</b><i></i>{article.time} de leitura</div>
    <h3>{article.title}</h3>
    <p>{article.excerpt}</p>
  </a>
</article>
